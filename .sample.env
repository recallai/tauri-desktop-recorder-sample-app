# Required: use the API URL for your Recall region.
RECALL_API_URL=https://YOUR-RECALL-REGION.recall.ai
RECALL_API_KEY=replace-with-your-recall-api-key
RECALL_WEBHOOK_SECRET=whsec_replace-with-your-webhook-secret

# Optional: defaults to 3000.
WEBHOOK_PORT=3000

# Optional: only set this for a reserved ngrok HTTPS domain.
PUBLIC_API_BASE_URL=
